# Copy this file to .env

# --- Groq (default) — get a free key at https://console.groq.com/keys ---
GROQ_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=openai/gpt-oss-20b      # faster, smaller
LLM_REASONING_EFFORT=low

# --- Other providers (optional) ---
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1      LLM_API_KEY=sk-...   LLM_MODEL=gpt-4o-mini
# Gemini:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_API_KEY=AIza...  LLM_MODEL=gemini-2.5-flash
# Claude:    LLM_PROVIDER=anthropic  LLM_API_KEY=sk-ant-...  LLM_MODEL=claude-sonnet-4-5
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1

LLM_MAX_TOKENS=2048
# ALLOWED_ORIGIN=https://your-site.vercel.app
